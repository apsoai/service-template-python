# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/apso_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=apso_db

# Server
HOST=0.0.0.0
PORT=3000
DEBUG=true
ENVIRONMENT=development

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT (optional - for auth)
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
